---
// Netlify Forms collects signups until an email tool is chosen. Export the list from Netlify later.
interface Props { id?: string; heading?: string; }
const { id = 'signup', heading = 'Get the weekly roundup' } = Astro.props;
---
<section class="panel signup" id={id} aria-labelledby={`${id}-h`} style="display:flex;flex-direction:column;gap:12px">
  <h2 id={`${id}-h`} class="display">{heading}</h2>
  <p>One email a week: the stories that mattered, what to do about them, and a free resource. Unsubscribe anytime.</p>
  <form name="subscribe" method="POST" action="/subscribe/thanks/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="subscribe" />
    <p class="hidden-field"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <label for={`${id}-email`} class="label">Email address</label>
    <input id={`${id}-email`} type="email" name="email" required autocomplete="email" placeholder="you@yourbusiness.com" />
    <fieldset style="border:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px;font-size:15px">
      <legend class="label" style="margin-bottom:6px">I mostly read as</legend>
      <label><input type="radio" name="reader" value="main" checked /> Business owner or nonprofit</label>
      <label><input type="radio" name="reader" value="trade" /> Marketer</label>
    </fieldset>
    <button type="submit" class="btn btn-hot">Send me the ledes</button>
  </form>
</section>
