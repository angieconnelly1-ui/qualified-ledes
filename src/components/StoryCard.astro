---
import type { Story } from '../data/stories';
import { topicLabel, audienceLabel, heatInfo, topicUrl } from '../data/taxonomy';

interface Props { story: Story; lead?: boolean; headingLevel?: 'h2' | 'h3'; }
const { story, lead = false, headingLevel = 'h3' } = Astro.props;
const d = story.data;
const H = headingLevel;
---
<article
  id={story.id}
  class:list={['card', 'panel', { 'is-lead': lead }]}
  data-topic={d.topic}
  data-aud={d.audience}
  data-heat={d.heat}
>
  <div class="meta">
    <span class={`stamp heat-${d.heat}`}>{heatInfo(d.heat).stamp}</span>
    <span><a href={topicUrl(d.topic)}>{topicLabel(d.topic)}</a> / {audienceLabel(d.audience)}</span>
  </div>
  <H class="display"><a href={`/stories/${story.id}/`} style="text-decoration:none">{d.headline}</a></H>
  <p>{d.dek}</p>
  <div class="do-this">
    <span class="label">Do this</span>
    <p>{d.doThis}</p>
  </div>
  {d.take && <p style="font-style:italic"><strong>Angie's take:</strong> {d.take}</p>}
  <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:auto">
    <a class="source" style="margin-top:0" href={`/stories/${story.id}/`}>Full lede</a>
    <a class="source" style="margin-top:0" href={d.url} rel="noopener" target="_blank">Read it at {d.source}</a>
  </div>
</article>
