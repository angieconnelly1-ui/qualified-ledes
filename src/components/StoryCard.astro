---
import type { Story } from '../data/stories';
import { topicLabel, audienceLabel, heatInfo } from '../data/taxonomy';

interface Props { story: Story; lead?: boolean; headingLevel?: 'h2' | 'h3'; }
const { story, lead = false, headingLevel = 'h3' } = Astro.props;
const d = story.data;
const H = headingLevel;
---
<article
  id={story.id}
  class:list={['card', 'panel', { 'is-lead': lead }]}
  data-topic={d.topic}
  data-aud={d.audience}
  data-heat={d.heat}
>
  <div class="meta">
    <span class={`stamp heat-${d.heat}`}>{heatInfo(d.heat).stamp}</span>
    <span><a href={`/topics/${d.topic}/`}>{topicLabel(d.topic)}</a> / {audienceLabel(d.audience)}</span>
  </div>
  <H class="display">{d.headline}</H>
  <p>{d.dek}</p>
  <div class="do-this">
    <span class="label">Do this</span>
    <p>{d.doThis}</p>
  </div>
  <a class="source" href={d.url} rel="noopener" target="_blank">Read it at {d.source}</a>
</article>
