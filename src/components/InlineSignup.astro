---
// Compact signup that sits inside the story grid, after the third story.
---
<section class="panel inline-signup" aria-labelledby="inline-signup-h" style="grid-column:1 / -1;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;background:var(--accent)">
  <div style="flex:1 1 300px">
    <h2 id="inline-signup-h" class="display" style="margin:0;font-size:24px">Like these? Get the best of the week by email.</h2>
    <p style="margin:4px 0 0;font-size:15px">One roundup a week, plus a free resource. Unsubscribe anytime.</p>
  </div>
  <form name="subscribe" method="POST" action="/subscribe/thanks/" data-netlify="true" netlify-honeypot="bot-field" style="display:flex;flex-wrap:wrap;gap:8px;flex:1 1 320px">
    <input type="hidden" name="form-name" value="subscribe" />
    <input type="hidden" name="reader" value="unknown" />
    <p class="hidden-field"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <label for="inline-email" class="hidden-field">Email address</label>
    <input id="inline-email" type="email" name="email" required autocomplete="email" placeholder="you@yourbusiness.com" style="flex:1 1 200px;min-height:44px;padding:0 12px;background:var(--paper);color:var(--ink);border:var(--bw) solid var(--ink);border-radius:var(--radius);font:16px var(--sans)" />
    <button type="submit" class="btn btn-ink">Subscribe</button>
  </form>
</section>
