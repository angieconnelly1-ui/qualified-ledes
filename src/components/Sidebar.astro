---
import { HEATS, TOPICS } from '../data/taxonomy';
import { MAGNET } from '../data/site';
import SignupForm from './SignupForm.astro';
interface Props { showTopics?: boolean; }
const { showTopics = true } = Astro.props;
---
<aside>
  <section class="panel key" aria-labelledby="key-h" style="display:flex;flex-direction:column;gap:12px">
    <h2 id="key-h" class="display">How hot is it?</h2>
    {HEATS.map((h) => (
      <div class="key-row"><span class={`stamp heat-${h.id}`} style="transform:none">{h.label}</span><span>{h.meaning}</span></div>
    ))}
  </section>

  <section class="panel magnet" aria-labelledby="magnet-h">
    <p class="label" style="margin:0">Lede magnet: free this week</p>
    <h2 id="magnet-h" class="display">{MAGNET.title}</h2>
    <p>{MAGNET.description}</p>
    {MAGNET.url
      ? <a class="btn btn-ink" style="align-self:flex-start" href={MAGNET.url}>Get the checklist</a>
      : <a class="btn btn-ink" style="align-self:flex-start" href="/subscribe/">Subscribe to get it first</a>}
  </section>

  <SignupForm />

  {showTopics && (
    <nav class="panel" aria-labelledby="topics-h" style="display:flex;flex-direction:column;gap:10px">
      <h2 id="topics-h" class="display" style="margin:0;font-size:24px">Browse by topic</h2>
      <div class="topic-links">
        {TOPICS.map((t) => <a href={`/topics/${t.id}/`}>{t.label}</a>)}
      </div>
    </nav>
  )}
</aside>
