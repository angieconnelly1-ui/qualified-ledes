---
import { TOPICS } from '../data/taxonomy';
import { MAGNET } from '../data/site';
import SignupForm from './SignupForm.astro';
interface Props { showTopics?: boolean; }
const { showTopics = true } = Astro.props;
---
<aside>
  <SignupForm
    kicker="Free this week"
    heading={MAGNET.title}
    blurb={`${MAGNET.description} Join the early list and it's yours first, along with the weekly email when it launches.`}
    magnet
  />

  {showTopics && (
    <nav class="panel" aria-labelledby="topics-h" style="display:flex;flex-direction:column;gap:10px">
      <h2 id="topics-h" class="display" style="margin:0;font-size:24px">Browse by topic</h2>
      <div class="topic-links">
        {TOPICS.map((t) => <a href={`/topics/${t.slug}/`}>{t.label}</a>)}
      </div>
    </nav>
  )}
</aside>
