---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search every Qualified Ledes story and guide.">
  <header style="display:flex;flex-direction:column;gap:8px">
    <h1 class="display" style="margin:0;font-size:clamp(40px,6vw,72px);line-height:1">Search</h1>
    <p class="subtag">Every story and guide, searchable in an instant.</p>
  </header>
  <main id="content" class="panel" style="padding:24px">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <noscript><p>Search needs JavaScript. Try the <a href="/archive/">archive</a> instead.</p></noscript>
  </main>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (!window.PagefindUI) return;
      new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false,
        translations: { placeholder: 'Search ledes and guides, e.g. Google Business Profile' } });
      var q = new URLSearchParams(location.search).get('q');
      var input = document.querySelector('#search input');
      if (input) {
        if (q) { input.value = q; input.dispatchEvent(new Event('input')); }
        input.addEventListener('change', function () { if (window.qlTrack) window.qlTrack('search', { search_term: input.value }); });
      }
    });
  </script>
</Base>
<style is:global>
  :root { --pagefind-ui-scale: 0.95; --pagefind-ui-primary: var(--ink); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--card); --pagefind-ui-border: var(--ink); --pagefind-ui-tag: var(--accent); --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 12px; --pagefind-ui-font: var(--sans); }
</style>
