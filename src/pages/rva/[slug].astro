---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import SignupForm from '../../components/SignupForm.astro';
import { render } from 'astro:content';
import { getRvaRoundups, RVA } from '../../data/rva';
import { getStories, formatDate } from '../../data/stories';
import { SITE, helpLink } from '../../data/site';

export async function getStaticPaths() {
  const all = await getRvaRoundups();
  return all.map((r, i) => ({ params: { slug: r.id }, props: { roundup: r, older: all[i + 1] ?? null, newer: all[i - 1] ?? null } }));
}
const { roundup, older, newer } = Astro.props;
const d = roundup.data;
const { Content } = await render(roundup);
const related = (await getStories()).filter((s) => s.data.topic === 'rva').slice(0, 3);
const url = new URL(`/rva/${roundup.id}/`, Astro.site).href;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: d.title,
    description: d.description,
    datePublished: d.date,
    dateModified: d.updated,
    url,
    mainEntityOfPage: url,
    image: new URL(SITE.ogImage, Astro.site).href,
    articleSection: RVA.name,
    keywords: d.keywords.join(', '),
    author: { '@id': `${SITE.url}/#angie` },
    publisher: { '@id': `${SITE.url}/#organization` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: RVA.name, item: `${SITE.url}${RVA.path}` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.seoTitle ?? d.title} description={d.description} type="article" published={d.date} jsonLd={jsonLd}>
  <div class="layout">
    <main id="content">
      <article data-pagefind-body data-read-type="rva" class="panel prose guide" style="max-width:none;padding:32px;display:flex;flex-direction:column;gap:6px">
        <nav aria-label="Breadcrumb" class="label"><a href={RVA.path}>{RVA.name}</a></nav>
        <h1 class="display" style="margin:8px 0">{d.title}</h1>
        <p data-pagefind-ignore style="margin:0;font-size:14px;color:var(--muted)">By <a href="/about/#angie">{SITE.author}</a>. <time datetime={d.date}>{formatDate(d.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time>{d.updated !== d.date && <> Updated <time datetime={d.updated}>{formatDate(d.updated, { month: 'long', day: 'numeric', year: 'numeric' })}</time>.</>}</p>
        <div class="do-this" style="margin:16px 0">
          <span class="label">This week in short</span>
          <p style="margin:0">{d.summary}</p>
        </div>
        {d.takeaways.length > 0 && (
          <section aria-labelledby="take-h">
            <h2 id="take-h" class="display">Key facts</h2>
            <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
          </section>
        )}
        <Content />
        {d.faq.length > 0 && (
          <section aria-labelledby="faq-h">
            <h2 id="faq-h" class="display">Common questions</h2>
            {d.faq.map((f) => (
              <>
                <h3 style="font-size:19px;margin:18px 0 4px">{f.q}</h3>
                <p style="margin:0">{f.a}{f.link && <> <a href={f.link.href} rel={f.link.href.startsWith('http') ? 'noopener' : undefined}>{f.link.text}</a></>}</p>
              </>
            ))}
          </section>
        )}
        <div style="display:flex;flex-wrap:wrap;gap:8px" data-pagefind-ignore>
          <button type="button" class="tool-btn" data-copy={`/rva/${roundup.id}/`}><span data-copy-label>Copy link</span></button>
          <a class="tool-btn" style="text-decoration:none" data-share-linkedin href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on LinkedIn</a>
        </div>
        <nav aria-label="More roundups" data-pagefind-ignore style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:15px">
          {older ? <a href={`/rva/${older.id}/`}>Previous week</a> : <span></span>}
          <a href={RVA.path}>All RVA Ledes roundups</a>
          {newer ? <a href={`/rva/${newer.id}/`}>Next week</a> : <span></span>}
        </nav>
      </article>

      <section class="panel" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between">
        <p style="margin:0;font-size:16px;flex:1 1 320px"><strong>Run a Richmond business or nonprofit?</strong> Get a free Google and AI visibility check.</p>
        <a class="btn btn-hot" href={helpLink('rva', roundup.id)} rel="noopener" data-free-check="rva">Get the free check</a>
      </section>

      {related.length > 0 && (
        <section aria-labelledby="related-h" style="display:flex;flex-direction:column;gap:16px">
          <h2 id="related-h" class="day-head display">Latest Richmond and Virginia ledes</h2>
          <div class="grid">{related.map((s) => <StoryCard story={s} />)}</div>
        </section>
      )}
    </main>
    <aside><SignupForm id="rva-signup" heading="Get RVA Ledes updates" /></aside>
  </div>
</Base>
