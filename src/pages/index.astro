---
import Base from '../layouts/Base.astro';
import StoryFeed from '../components/StoryFeed.astro';
import Sidebar from '../components/Sidebar.astro';
import PaperBar from '../components/PaperBar.astro';
import { getStories } from '../data/stories';
import { SITE } from '../data/site';

const all = await getStories();
// The front page shows the last 14 days that have stories. Everything else lives in the archive.
const days = [...new Set(all.map((s) => s.data.date))].slice(0, 14);
const stories = all.filter((s) => days.includes(s.data.date));
---
<Base>
  <header class="masthead">
    <div class="masthead-text">
      <h1 class="display">{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
      <p class="subtag">Marketing news for small businesses, nonprofits and the marketers who serve them. Updated every weekday.</p>
    </div>
    <div class="starburst" aria-hidden="true"><span>Extra!<br />Fresh ledes</span></div>
  </header>

  <div class="layout">
    <main id="content">
      <PaperBar />
      <StoryFeed stories={stories} />
      <p style="margin:0"><a href="/archive/">Browse every lede in the archive</a></p>
    </main>
    <Sidebar />
  </div>
</Base>
